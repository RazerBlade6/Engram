# Local development settings. Copy to `.env` in the repo root and fill the two keys from
# `supabase status` (Publishable and Secret). docker compose reads this file, and so do the
# API and worker when run from backend/.

# Backend (API and worker)
ENGRAM_SUPABASE_SECRET_KEY=
# Anthropic API key, used by the worker to describe figures (and later for cards and chat).
ANTHROPIC_API_KEY=
# Outside Docker these defaults already match `supabase start`:
# ENGRAM_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# ENGRAM_SUPABASE_URL=http://127.0.0.1:54321

# Web app (also copy to web/.env.local for `npm run dev` outside Docker)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
