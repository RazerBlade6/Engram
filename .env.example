# Copy to backend/.env for running the API or worker outside docker compose.
ENGRAM_ENVIRONMENT=development
ENGRAM_DATABASE_URL=postgresql://engram:engram@localhost:5432/engram
ENGRAM_CORS_ORIGINS=["http://localhost:3000"]

# Copy to web/.env.local for running the web app outside docker compose.
NEXT_PUBLIC_API_URL=http://localhost:8000
